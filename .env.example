# ==============================================================================
# Domain & SSL Configuration
# ==============================================================================
# Set your domain and subdomain. Example: n8n.yourdomain.com
# If you are deploying directly to the root domain, leave SUBDOMAIN empty.
DOMAIN_NAME=yourdomain.com
SUBDOMAIN=n8n

# Your email address for Let's Encrypt SSL expiry notifications
SSL_EMAIL=admin@yourdomain.com

# Timezone (e.g. Asia/Hong_Kong, America/New_York, UTC)
GENERIC_TIMEZONE=UTC

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=n8n_db
POSTGRES_PORT=5432

# ==============================================================================
# n8n Security & Encryption Key
# ==============================================================================
# Generate a random 32+ character key for encrypting stored credentials.
# You can generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=generate_a_random_32_char_hex_key_here

# Telemetry / Metrics (set to true if desired)
N8N_METRICS=false
N8N_DIAGNOSTICS_ENABLED=false

# ==============================================================================
# Task Runners (Code Execution Sandbox)
# ==============================================================================
# Secret token for authenticating isolated runners container to n8n task broker.
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=generate_a_random_runners_token_here

# ==============================================================================
# AI Assistant & Code Sandbox Secrets
# ==============================================================================
# Shared secrets between n8n, sandbox-api, and sandbox-runner containers.
# Generate with: openssl rand -hex 32
SANDBOX_API_KEY=generate_a_random_sandbox_api_key_here
SANDBOX_REGISTRATION_TOKEN=generate_a_random_registration_token_here
SANDBOX_RUNNER_API_KEY=generate_a_random_runner_api_key_here

# ==============================================================================
# Web Search for AI Assistant (SearXNG)
# ==============================================================================
# Secret key for the bundled internal SearXNG search instance.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=generate_a_random_searxng_secret_here
